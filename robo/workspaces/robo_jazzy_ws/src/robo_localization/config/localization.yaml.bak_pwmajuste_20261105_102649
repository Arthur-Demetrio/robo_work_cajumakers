command_imu_odometry:
  ros__parameters:
    use_sim_time: false
    cmd_vel_topic: /cmd_vel
    imu_topic: /imu/data
    odom_topic: /odom

    odom_frame: odom
    base_frame: base_link
    publish_tf: true
    publish_rate_hz: 50.0

    # Iguais ao watchdog do hardware. Um comando antigo nao e integrado.
    command_timeout_s: 0.25
    imu_timeout_s: 0.20
    maximum_integration_step_s: 0.10

    # Escalas registradas antes dos testes de centralizacao de 01/10.
    linear_scale_x: 5.0
    linear_scale_y: 6.0

    # ODOM_TABELA (04/11): velocidade pela tabela medida, nao pela escala acima
    # (escala so vale com velocity_model: escala). Medida com teste_velocidade_v2, PWM 150:
    # distancia andada / 1,6 s, media de + e -. Trocou o PWM: medir de novo e trocar as listas.
    velocity_model: tabela
    speed_table_cmd: [0.0200, 0.0300, 0.0500, 0.0800, 0.1200, 0.1600, 0.2000, 0.3100]  # PWM60 comando
    speed_table_x: [0.0898, 0.0971, 0.1117, 0.1336, 0.1628, 0.1920, 0.2212, 0.3015]  # PWM60 frente, ponte minimo 60 / max 0,31
    speed_table_y: [0.0539, 0.0583, 0.0670, 0.0802, 0.0977, 0.1152, 0.1327, 0.1809]  # PWM60 lado = 0,6 x frente
    speed_deadband: 0.005

    # Covariancias deliberadamente conservadoras, pois nao ha encoders.
    position_variance: 0.25
    yaw_variance: 0.02
    linear_velocity_variance: 0.10
    angular_velocity_variance: 0.02
