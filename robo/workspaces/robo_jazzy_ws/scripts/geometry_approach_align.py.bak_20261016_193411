#!/usr/bin/env python3
import argparse, math, time, sys
import rclpy
from rclpy.time import Time
from rclpy.qos import qos_profile_sensor_data
from geometry_msgs.msg import PoseStamped
from sensor_msgs.msg import LaserScan
from tf2_ros import Buffer, TransformListener
from lifecycle_msgs.srv import GetState
from nav2_simple_commander.robot_navigator import BasicNavigator, TaskResult

rad = math.radians
deg = math.degrees

def wrap(a):
    return math.atan2(math.sin(a), math.cos(a))

def yaw(q):
    return math.atan2(
        2*(q.w*q.z+q.x*q.y),
        1-2*(q.y*q.y+q.z*q.z)
    )

class Align(BasicNavigator):
    def __init__(self):
        super().__init__(node_name='geometry_align')
        self.buf = Buffer()
        self.listener = TransformListener(self.buf, self)
        self.scan_age = 999.
        self.last_scan = 0.
        self.scan_sub = self.create_subscription(
            LaserScan, '/scan_front',
            self.on_scan, qos_profile_sensor_data
        )
        self.moving = False

    def on_scan(self, msg):
        self.last_scan = time.monotonic()
        self.scan_age = (
            self.get_clock().now() -
            Time.from_msg(msg.header.stamp)
        ).nanoseconds/1e9

    def tf(self, target='map'):
        t = self.buf.lookup_transform(
            target, 'base_link', Time()
        )
        dt = (
            self.get_clock().now() -
            Time.from_msg(t.header.stamp)
        ).nanoseconds/1e9

        if not -0.25 <= dt <= 0.6:
            raise RuntimeError(f'TF antigo: {dt:.2f}s')
        return t

    def active(self, node):
        c = self.create_client(
            GetState, '/'+node+'/get_state'
        )
        if not c.wait_for_service(timeout_sec=2.):
            raise RuntimeError(
                'Lifecycle indisponivel: '+node
            )
        f = c.call_async(GetState.Request())
        rclpy.spin_until_future_complete(
            self, f, timeout_sec=2.
        )
        if (not f.done() or f.result() is None
                or f.result().current_state.id != 3):
            raise RuntimeError('No nao ativo: '+node)

    def guard(self):
        if (time.monotonic()-self.last_scan > 0.7
                or not -0.25 <= self.scan_age <= 0.7):
            raise RuntimeError(
                'LiDAR ausente ou timestamp divergente'
            )

        for n in (
            'collision_monitor', 'velocity_smoother',
            'bt_navigator', 'controller_server'
        ):
            self.active(n)

        self.tf()

    def clearance_spin(self, radius=0.60):
        self.guard()

        costmap = self.getLocalCostmap()

        if costmap is None:
            raise RuntimeError('Sem costmap local')

        m = costmap.metadata
        t = self.tf(costmap.header.frame_id)

        cx = t.transform.translation.x
        cy = t.transform.translation.y

        ox = m.origin.position.x
        oy = m.origin.position.y

        res = m.resolution
        w = m.size_x
        h = m.size_y

        if res <= 0 or abs(wrap(yaw(m.origin.orientation))) > 0.001:
            raise RuntimeError(
                'Costmap invalido ou rotacionado'
            )

        if not (
            ox+radius <= cx <= ox+w*res-radius
            and oy+radius <= cy <= oy+h*res-radius
        ):
            raise RuntimeError(
                'Area de giro nao cabe no costmap'
            )

        if len(costmap.data) != w*h:
            raise RuntimeError(
                'Dados do costmap incompletos'
            )

        i0 = max(0, int((cx-radius-2*res-ox)/res))
        i1 = min(w-1, int((cx+radius+2*res-ox)/res))
        j0 = max(0, int((cy-radius-2*res-oy)/res))
        j1 = min(h-1, int((cy+radius+2*res-oy)/res))

        total = 0

        for j in range(j0, j1+1):
            for i in range(i0, i1+1):
                dist = math.hypot(
                    ox+(i+.5)*res-cx,
                    oy+(j+.5)*res-cy
                )

                if dist <= radius + res*.71:
                    total += 1
                    value = costmap.data[j*w+i]

                    if value >= 253:
                        raise RuntimeError(
                            f'Giro bloqueado pelo costmap '
                            f'a {dist:.2f} m'
                        )

        if total < 10:
            raise RuntimeError(
                'Area de giro nao verificavel'
            )

def pose(nav, x, y, angle):
    p = PoseStamped()
    p.header.frame_id = 'map'
    p.header.stamp = nav.get_clock().now().to_msg()
    p.pose.position.x = x
    p.pose.position.y = y
    p.pose.orientation.z = math.sin(angle/2)
    p.pose.orientation.w = math.cos(angle/2)
    return p

def finish(nav, name, timeout):
    t0 = time.monotonic()

    while rclpy.ok() and not nav.isTaskComplete():
        if (time.monotonic()-t0 > timeout
                or time.monotonic()-nav.last_scan > 0.8):
            nav.cancelTask()
            nav.isTaskComplete()
            nav.moving = False
            raise RuntimeError(
                f'{name}: timeout ou LiDAR sem dados'
            )

    nav.moving = False

    if nav.getResult() != TaskResult.SUCCEEDED:
        raise RuntimeError(f'{name}: acao falhou')

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--stage-x', type=float)
    ap.add_argument('--stage-y', type=float)
    ap.add_argument('--axis-deg', type=float, required=True)
    ap.add_argument('--only-align', action='store_true')
    ap.add_argument('--execute', action='store_true')
    args = ap.parse_args()

    if not args.only_align and (
        args.stage_x is None or args.stage_y is None
    ):
        ap.error(
            'Informe stage-x e stage-y, '
            'ou use --only-align'
        )

    rclpy.init()
    n = Align()

    try:
        for _ in range(20):
            rclpy.spin_once(n, timeout_sec=.1)

        n.guard()

        t = n.tf()
        x = t.transform.translation.x
        y = t.transform.translation.y
        a = yaw(t.transform.rotation)
        target = wrap(rad(args.axis_deg))

        print(
            f'Atual ({x:.2f}, {y:.2f}), '
            f'yaw={deg(a):.1f} graus, '
            f'alvo={deg(target):.1f} graus'
        )

        if not args.only_align:
            p = pose(n, args.stage_x, args.stage_y, a)
            path = n.getPath(
                pose(n, x, y, a),
                p,
                use_start=True
            )

            if path is None or not path.poses:
                raise RuntimeError(
                    'Sem caminho planejado para ponto de espera'
                )

            print(
                f'ApproachAlign: {len(path.poses)} '
                'poses no caminho'
            )

        if not args.execute:
            print(
                'MODO PREVIA: nenhum movimento enviado'
            )
            return

        if not args.only_align:
            n.moving = True
            n.goToPose(p)
            finish(n, 'ApproachAlign', 90)
            n.guard()

            t = n.tf()

            if math.hypot(
                t.transform.translation.x-args.stage_x,
                t.transform.translation.y-args.stage_y
            ) > .10:
                raise RuntimeError(
                    'Nao chegou ao ponto de espera '
                    'com tolerancia de 10cm'
                )

        for i in range(12):
            n.guard()
            error = wrap(
                target-yaw(n.tf().transform.rotation)
            )

            print(
                f'MicroAlign {i+1}: '
                f'erro {deg(error):+.1f} graus'
            )

            if abs(error) <= rad(3):
                print(
                    'ALINHADO. Nenhum comando de '
                    'atravessar corredor enviado.'
                )
                return

            n.clearance_spin(.60)

            step = max(
                -rad(5), min(rad(5), error)
            )

            n.moving = True
            n.spin(
                spin_dist=step,
                time_allowance=12.
            )
            finish(n, 'MicroAlign', 15)

        raise RuntimeError(
            'Nao alinhou em 12 microgiros'
        )

    finally:
        if n.moving:
            try:
                n.cancelTask()
                n.isTaskComplete()
            except Exception:
                print(
                    'ATENCAO: nao foi possivel '
                    'confirmar cancelamento',
                    file=sys.stderr
                )
        n.destroyNode()
        rclpy.shutdown()

if __name__ == '__main__':
    try:
        main()
    except Exception as e:
        print('BLOQUEADO:', e, file=sys.stderr)
        sys.exit(2)
